# Harmonia + OpenCode Configuration
# Copie para .env e preencha os valores

# ==========================================
# OPENCODE SERVER
# ==========================================
# Rodar: docker run -d -p 4096:4096 -v $(pwd)/workspace:/workspace ghcr.io/anomalyco/opencode:latest serve --host 0.0.0.0 --port 4096
OPENCODE_SERVER_URL=http://localhost:4096
OPENCODE_SERVER_PASSWORD=sua_senha_aqui

# ==========================================
# LLM PROVIDERS (pelo menos um necessário)
# ==========================================
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GITHUB_TOKEN=ghp_...

# ==========================================
# POSTGRESQL (checkpoint LangGraph)
# ==========================================
POSTGRES_DSN=postgresql://postgres:harmonia@localhost:5432/harmonia

# ==========================================
# TELEGRAM BOT (Ligadão/Soninho - já existente)
# ==========================================
# 1. Criar bot no @BotFather
# 2. Configurar webhook: https://api.telegram.org/bot<TOKEN>/setWebhook?url=<SEU_NGROK>/webhook/<TOKEN>
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=123456789:ABC...
TELEGRAM_WEBHOOK_URL=https://seu-dominio.ngrok-free.app
TELEGRAM_SECRET_TOKEN=seu_secret_token
TELEGRAM_ALLOWED_USERS=123456789,987654321

# ==========================================
# WHATSAPP (Baileys - NOVO)
# ==========================================
# IMPORTANTE: Use número DEDICADO (chip pré-pago) - NUNCA seu número principal!
# Risco real de banimento por automação não-oficial do WhatsApp Web.
# Baileys roda em Node.js - servidor criado automaticamente em harmonia/integrations/baileys_server/
WHATSAPP_ENABLED=false
WHATSAPP_SESSION_NAME=harmonia
WHATSAPP_BAILEYS_PORT=3001
WHATSAPP_BAILEYS_HOST=localhost
WHATSAPP_WEBHOOK_URL=https://seu-dominio.ngrok-free.app/whatsapp/webhook
WHATSAPP_SECRET_TOKEN=seu_secret_token_whatsapp
# Formato: "5511999999999@s.whatsapp.net" (código país + DDD + número + @s.whatsapp.net)
WHATSAPP_ALLOWED_NUMBERS=5511999999999@s.whatsapp.net
WHATSAPP_SESSION_DIR=./whatsapp_session

# ==========================================
# VOZ - TWILIO + NVIDIA (NOVO)
# ==========================================
# Twilio: Ligação telefônica REAL (seu telefone toca)
# NVIDIA: ASR (fala→texto) + TTS (texto→fala) + VoiceChat (full-duplex)
# 
# Twilio: https://console.twilio.com/ (Account SID, Auth Token, número verificado)
# NVIDIA: https://www.nvidia.com/en-us/ai/voicechat/ (API key, acesso antecipado)
# Alguns modelos de voz personalizada exigem aprovação prévia de acesso.
VOICE_ENABLED=false

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+15551234567    # Número Twilio que liga
TWILIO_TO_NUMBER=+5511999999999    # SEU número que recebe a ligação
TWILIO_WEBHOOK_URL=https://seu-dominio.ngrok-free.app/voice/webhook
TWILIO_RECORDING=true

# NVIDIA
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://api.nvidia.com/v1
NVIDIA_RIVA_URL=grpc://riva.nvidia.com:50051
NVIDIA_USE_VOICECHAT=true
NVIDIA_LANGUAGE=pt-BR
NVIDIA_VOICE_NAME=pt-BR-Neural-Female-1
NVIDIA_SAMPLE_RATE=16000

# ==========================================
# INTENÇÃO (Interpretador linguagem natural → aprovação)
# ==========================================
# Usa o próprio OpenCode/Claude/GPT já configurado
INTENCAO_MODEL=  # Opcional: modelo específico para classificação

# ==========================================
# HARMONIA GENERAL
# ==========================================
HARMONIA_DIAL=soninho  # ligadao | soninho
LOG_LEVEL=INFO